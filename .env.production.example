# ============================================================================
#  PRODUCTION environment — Galerie Virtuelle Nationale de l'Artisanat du Cameroun
#  Copy to `.env` on the server, fill every REQUIRED value, then:
#    php artisan key:generate
#  NEVER commit the real .env. NEVER set APP_DEBUG=true in production.
# ============================================================================

APP_NAME="Artisan Hub 237"
APP_ENV=production
APP_KEY=                                   # REQUIRED — run: php artisan key:generate
APP_DEBUG=false                            # REQUIRED false
APP_URL=https://artisanhub237.com   # REQUIRED — must match the public host (asset() + sitemap use it)
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error                            # error/warning in prod (not debug)

# --- Database (REQUIRED) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=artisanatcameroun
DB_USERNAME=REPLACE
DB_PASSWORD=REPLACE

# --- Sessions / cache / queue ---
BROADCAST_CONNECTION=log
CACHE_STORE=file                           # or redis if available
QUEUE_CONNECTION=database                  # a queue:work worker must run (see deploy.sh)
SESSION_DRIVER=database
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail (drives signup email verification, contact form, notifications) ---
# Ships as 'log' on purpose: a half-configured SMTP relay throws on every send,
# and email verification gates business creation, product publishing and
# messaging. With 'log' the codes land in storage/logs/laravel.log instead of
# blocking new members. Switch to smtp once the relay is confirmed working.
MAIL_MAILER=log
# MAIL_MAILER=smtp
MAIL_HOST=REPLACE
MAIL_PORT=587
MAIL_USERNAME=REPLACE
MAIL_PASSWORD=REPLACE
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="noreply@artisanhub237.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Object storage (optional — local public disk is used if blank) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=
AWS_PRIVATE_BUCKET=
AWS_BACKUP_BUCKET=
AWS_URL=

# --- Search (optional) ---
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=
SCOUT_DRIVER=database                      # 'database' needs no external service; 'meilisearch' does

# --- Error monitoring (optional but recommended) ---
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Payments (fill when going live with real collections) ---
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_ENVIRONMENT=sandbox               # switch to 'production' with live credentials
ORANGE_MONEY_BASE_URL=https://api.orange.com
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=

PLATFORM_FEE_PERCENT=2.5
VAT_PERCENT=19.25

# --- WhatsApp OTP (optional) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# --- Company identity (shown on /legal/mentions-legales and in contact emails) ---
LEGAL_COMPANY_NAME="Artisan Hub 237"
LEGAL_COMPANY_FORM="SARL"
LEGAL_COMPANY_REG=              # RCCM number
LEGAL_COMPANY_TAX=              # Numéro de contribuable
LEGAL_COMPANY_ADDRESS="Douala, Littoral, Cameroun"
LEGAL_COMPANY_EMAIL="contact@artisanhub237.com"
LEGAL_COMPANY_PHONE=
LEGAL_HOSTING_PROVIDER=

# --- Social profiles (blank = the icon is not rendered) ---
SOCIAL_FACEBOOK=
SOCIAL_INSTAGRAM=
SOCIAL_LINKEDIN=
SOCIAL_YOUTUBE=
SOCIAL_X=

# --- Demo logins on /login: leave unset in production ---
APP_DEMO_LOGIN=false
