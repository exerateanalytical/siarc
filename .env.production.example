# ============================================================================
#  PRODUCTION environment template — artisanhub237.com (Namecheap shared host)
#
#  This file is COMMITTED and therefore contains placeholders only. The filled
#  copy lives outside git as `.env.production` (gitignored) and becomes the
#  server's `.env`:
#
#      cp .env.production .env && chmod 600 .env
#      php artisan key:generate        # only if APP_KEY is still blank
#
#  NEVER commit a real password, and NEVER set APP_DEBUG=true in production.
# ============================================================================

APP_NAME="Artisan Hub 237"
APP_ENV=production
APP_KEY=                                   # REQUIRED — php artisan key:generate
APP_DEBUG=false                            # REQUIRED false
APP_URL=https://artisanhub237.com          # REQUIRED — asset(), sitemap and mail links are built from this
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en

# ── Logging ────────────────────────────────────────────────────────────────
# 'daily' rather than 'single': shared hosting has a disk quota, and a single
# laravel.log grows without bound until the account is full and every write on
# the site starts failing. 14 files is roughly a fortnight of history.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=error                            # error/warning in prod, never debug
LOG_DEPRECATIONS_CHANNEL=null

# ── Database (REQUIRED) ────────────────────────────────────────────────────
#
#  !! IF THE PASSWORD CONTAINS '#', KEEP IT IN SINGLE QUOTES !!
#
#  In an unquoted .env value phpdotenv treats '#' as the start of a comment and
#  silently truncates the rest of the line. Verified against this project's own
#  vendored phpdotenv:
#
#      DB_PASSWORD=Secret123#$     ->  parses as  Secret123    (9 chars)
#      DB_PASSWORD='Secret123#$'   ->  parses as  Secret123#$  (11 chars)
#
#  Truncated, the app cannot reach MySQL and every page is a 500 with nothing
#  in the log to explain it. Use SINGLE quotes, not double: inside double
#  quotes phpdotenv expands '$' as a variable reference.
#
DB_CONNECTION=mysql
DB_HOST=127.0.0.1                          # cPanel MySQL is on the same host
DB_PORT=3306
DB_DATABASE=REPLACE_DB_NAME                # cPanel prefixes it, e.g. cpaneluser_dbname
DB_USERNAME=REPLACE_DB_USER
DB_PASSWORD='REPLACE_DB_PASSWORD'          # keep the single quotes — see above

# ── Sessions / cache / queue ───────────────────────────────────────────────
#
#  All three must need nothing but the local filesystem and MySQL. Namecheap
#  shared hosting has no Redis and no Memcached; selecting either produces a
#  connection-refused on the very first request.
#
#  SESSION_DRIVER and CACHE_STORE are 'file', NOT 'database': this schema has
#  no `sessions` table and no `cache` table (the Laravel skeleton migrations
#  that create them are not in database/migrations). 'database' fails on the
#  first request with "Base table or view not found".
#
#  QUEUE_CONNECTION is 'sync' because shared hosting cannot supervise a
#  long-running `queue:work`. Queued work then runs inline on the request that
#  triggers it — always correct, just slower. Never set 'database' without a
#  worker: the jobs would sit in the table forever and no mail would go out.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true                 # the site is HTTPS-only
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ── Shared-hosting document root ───────────────────────────────────────────
# Set ONLY when the host dictates a document root the application cannot live
# inside — cPanel's ~/public_html. Names that directory, relative to the
# application root. It is what makes `storage:link` create the symlink where
# the browser will actually ask for it, and what makes the email letterhead
# embed resolve. Leave UNSET on any normal install, where <app>/public is the
# document root.
APP_PUBLIC_PATH=../public_html

# ── HTTPS behind the host's proxy ──────────────────────────────────────────
# The origin receives plain HTTP with X-Forwarded-Proto: https. Without these
# two, request()->secure() is false, url()/asset() emit http:// links and the
# browser blocks them as mixed content on an https page.
TRUSTED_PROXIES=*
FORCE_HTTPS=true

# ── Mail ───────────────────────────────────────────────────────────────────
#
#  !! SAME '#' TRUNCATION APPLIES TO MAIL_PASSWORD — keep the single quotes.
#
#  MAIL_SCHEME, not MAIL_ENCRYPTION. Laravel 11+ dropped MAIL_ENCRYPTION
#  entirely; config/mail.php reads MAIL_SCHEME, so MAIL_ENCRYPTION=ssl here
#  would be read by nothing at all. 'smtps' with port 465 is implicit TLS
#  (encrypted from the first byte). Do NOT pair 465 with STARTTLS ('tls',
#  which is for 587): the handshake fails and every send throws.
#
#  The From address must be a real mailbox on the sending domain — an address
#  the relay does not own gets the mail rejected or filed as spam.
MAIL_MAILER=smtp                           # 'log' while the relay is unproven
MAIL_HOST=mail.artisanhub237.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=welcome@artisanhub237.com
MAIL_PASSWORD='REPLACE_MAILBOX_PASSWORD'   # keep the single quotes — see above
MAIL_FROM_ADDRESS="welcome@artisanhub237.com"
MAIL_FROM_NAME="Artisan Hub 237"

# ── Certification Authority signing key ────────────────────────────────────
# Generated ON THE SERVER with `php artisan certificates:init-authority`.
# The default path storage/app/ca/ah237-ca.key sits above public_html and is
# therefore not web-reachable. Never upload the development key.
# CERTIFICATE_CA_KEY_PATH=

# ── Object storage (optional — the local public disk is used if blank) ─────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=
AWS_PRIVATE_BUCKET=
AWS_BACKUP_BUCKET=
AWS_URL=

# ── Search ─────────────────────────────────────────────────────────────────
SCOUT_DRIVER=database                      # 'database' needs no external service; 'meilisearch' does
MEILISEARCH_HOST=
MEILISEARCH_KEY=

# ── Error monitoring (optional but recommended) ────────────────────────────
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Payments (fill when going live with real collections) ──────────────────
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_ENVIRONMENT=sandbox               # switch to 'production' with live credentials
ORANGE_MONEY_BASE_URL=https://api.orange.com
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=

PLATFORM_FEE_PERCENT=2.5
VAT_PERCENT=19.25

# ── Manual payment gateway ─────────────────────────────────────────────────
# Platform fees only. Empty means the method is excluded from the site
# entirely rather than rendered blank — an empty payment number is money sent
# to nobody.
PAYMENT_MTN_NUMBER=
PAYMENT_MTN_NAME=
PAYMENT_ORANGE_NUMBER=
PAYMENT_ORANGE_NAME=

# ── WhatsApp OTP (optional) ────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# ── Company identity (shown on /legal/mentions-legales and in contact mail) ─
LEGAL_COMPANY_NAME="Artisan Hub 237"
LEGAL_COMPANY_FORM="SARL"
LEGAL_COMPANY_REG=                         # RCCM number
LEGAL_COMPANY_TAX=                         # Numéro de contribuable
LEGAL_COMPANY_ADDRESS="Douala, Littoral, Cameroun"
LEGAL_COMPANY_EMAIL="contact@artisanhub237.com"
LEGAL_COMPANY_PHONE=
LEGAL_HOSTING_PROVIDER="Namecheap, Inc."

# ── Social profiles (blank = the icon is not rendered) ─────────────────────
SOCIAL_FACEBOOK=
SOCIAL_INSTAGRAM=
SOCIAL_LINKEDIN=
SOCIAL_YOUTUBE=
SOCIAL_X=

# ── Demo logins on /login: never in production ─────────────────────────────
APP_DEMO_LOGIN=false
