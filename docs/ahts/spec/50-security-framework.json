{
  "security_framework": {
    "metadata": {
      "name": "ArtisanHub237 Security Framework",
      "abbreviation": "AHSF",
      "version": "1.0.0",
      "description": "Comprehensive physical, digital, cryptographic and operational security standards for the ArtisanHub237 Trust Infrastructure.",
      "authority": "ArtisanHub237 Certification Authority"
    },
    "security_objectives": [
      "Prevent certificate forgery",
      "Prevent counterfeit products",
      "Guarantee certificate integrity",
      "Guarantee document authenticity",
      "Provide non-repudiation",
      "Enable public verification",
      "Maintain complete audit trails",
      "Support long-term archival"
    ],
    "security_levels": [
      { "code": "L1", "name": "Basic", "description": "Internal administrative documents." },
      { "code": "L2", "name": "Standard", "description": "General official certificates." },
      { "code": "L3", "name": "Enhanced", "description": "Museum-grade certificates." },
      { "code": "L4", "name": "High Security", "description": "Government-grade and export certificates." },
      { "code": "L5", "name": "Critical", "description": "Root authority documents and master records." }
    ],
    "physical_security": {
      "enabled": true,
      "features": [
        { "id": "PS001", "name": "Guilloche Pattern", "mandatory": true },
        { "id": "PS002", "name": "Microtext", "mandatory": true },
        { "id": "PS003", "name": "Invisible UV Ink", "mandatory": false },
        { "id": "PS004", "name": "Embossed Seal", "mandatory": true },
        { "id": "PS005", "name": "Gold Foil Seal", "mandatory": true },
        { "id": "PS006", "name": "Ghost Watermark", "mandatory": true },
        { "id": "PS007", "name": "Anti-Copy Background", "mandatory": true },
        { "id": "PS008", "name": "Security Fibers", "mandatory": false },
        { "id": "PS009", "name": "Serial Number Printing", "mandatory": true },
        { "id": "PS010", "name": "Latent Image", "mandatory": false }
      ]
    },
    "digital_security": {
      "hash_algorithm": "SHA-256",
      "supported_hashes": ["SHA-256", "SHA-384", "SHA-512"],
      "digital_signature": {
        "enabled": true,
        "algorithm": "RSA-4096",
        "alternative_algorithms": ["ECDSA P-384", "Ed25519"],
        "timestamp_required": true,
        "non_repudiation": true
      },
      "certificate_hash": { "stored": true, "immutable": true, "verification_required": true }
    },
    "public_key_infrastructure": {
      "enabled": true,
      "root_certificate_authority": { "name": "AHCA Root CA", "offline": true, "key_size": 4096 },
      "issuing_certificate_authorities": [
        { "name": "AHCA Issuing CA", "purpose": "Certificate Issuance" },
        { "name": "AHCA Verification CA", "purpose": "Verification Services" }
      ],
      "certificate_validity": { "default_years": 10, "renewable": true }
    },
    "qr_security": {
      "dynamic": true,
      "contains": ["Certificate UUID", "Verification URL", "Document Hash", "Certificate Type", "Issue Date"],
      "tamper_detection": true,
      "expiration": { "enabled": false }
    },
    "nfc_security": {
      "enabled": true,
      "write_once": true,
      "contains": ["UUID", "Certificate Number", "Verification Endpoint"]
    },
    "verification": {
      "public_verification": true,
      "requires": ["Certificate Number", "UUID", "QR", "Digital Signature"],
      "verification_status": ["VALID", "EXPIRED", "SUSPENDED", "REVOKED", "UNKNOWN"]
    },
    "audit_trail": {
      "enabled": true,
      "immutable": true,
      "capture": ["Event ID", "Timestamp", "Actor", "Action", "Entity", "Previous Value", "New Value", "Reason", "IP Address", "User Agent", "Digital Signature"],
      "retention_years": 50
    },
    "revocation": {
      "enabled": true,
      "reasons": ["Fraud", "Forgery", "Administrative Error", "Court Order", "Owner Request", "Security Breach"],
      "publicly_visible": true
    },
    "data_protection": {
      "encryption_at_rest": { "enabled": true, "algorithm": "AES-256-GCM" },
      "encryption_in_transit": { "minimum_tls_version": "1.3" },
      "key_rotation": { "enabled": true, "rotation_period_days": 365 }
    },
    "authentication": {
      "multi_factor_authentication": true,
      "supported_methods": ["Password", "TOTP", "Security Key", "Passkey", "Biometric"]
    },
    "authorization": {
      "model": "RBAC",
      "roles": ["Super Administrator", "Certification Officer", "Verification Officer", "Registry Officer", "Auditor", "Curator", "Artisan", "Collector", "Public User"]
    },
    "fraud_detection": {
      "enabled": true,
      "checks": ["Duplicate Certificates", "Hash Mismatch", "QR Tampering", "Signature Validation", "Ownership Conflict", "Duplicate Product Images", "Suspicious Registration Pattern", "High Risk Export"]
    },
    "incident_response": {
      "severity_levels": ["LOW", "MEDIUM", "HIGH", "CRITICAL"],
      "response_actions": ["Notify Security Team", "Suspend Certificate", "Freeze Registry Record", "Launch Investigation", "Generate Audit Report", "Notify Affected Parties"]
    },
    "business_continuity": {
      "daily_backups": true,
      "geo_redundant_storage": true,
      "integrity_checks": true,
      "disaster_recovery": { "recovery_time_objective_hours": 4, "recovery_point_objective_minutes": 15 }
    },
    "compliance": {
      "security_principles": ["Confidentiality", "Integrity", "Availability", "Authenticity", "Accountability", "Non-Repudiation"],
      "references": ["ISO/IEC 27001", "ISO/IEC 27002", "ISO/IEC 27017", "ISO/IEC 27018", "ISO 22301", "NIST Cybersecurity Framework"]
    },
    "future_reserved": {
      "post_quantum_cryptography": { "enabled": false },
      "hardware_security_module": { "enabled": false },
      "confidential_computing": { "enabled": false },
      "zero_knowledge_proofs": { "enabled": false }
    }
  }
}
