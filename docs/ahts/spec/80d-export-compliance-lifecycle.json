{
  "export_compliance_verification_lifecycle": {
    "metadata": {
      "name": "Export, Compliance, Verification APIs, Timeline, Lifecycle & Digital Twin",
      "abbreviation": "ECVLDT",
      "version": "1.0.0",
      "parent_standard": "ArtisanHub237 Digital Product Passport",
      "description": "Defines export compliance, legal compliance, verification services, APIs, lifecycle management, digital timeline, interoperability, and Digital Twin architecture."
    },
    "export_management": {
      "exportable": true,
      "export_status": ["NOT_ELIGIBLE", "PENDING_REVIEW", "ELIGIBLE", "APPROVED", "EXPORTED", "RESTRICTED", "PROHIBITED"],
      "current_status": "PENDING_REVIEW",
      "export_profile": {
        "export_uuid": "",
        "export_certificate_number": "",
        "export_license": "",
        "issuing_authority": "",
        "country_of_origin": "",
        "destination_country": "",
        "customs_reference": "",
        "export_reason": "",
        "export_category": [
          "Commercial", "Museum Loan", "Private Collection", "Temporary Exhibition",
          "Academic Research", "Government", "Restoration", "Other"
        ],
        "departure_date": "",
        "expected_return_date": "",
        "permanent_export": false,
        "requires_return": false
      },
      "shipping": {
        "carrier": "",
        "tracking_number": "",
        "shipment_uuid": "",
        "shipping_method": ["Air", "Sea", "Road", "Rail"],
        "packaging_standard": "",
        "insurance_reference": "",
        "condition_before_shipping": "",
        "condition_after_delivery": ""
      }
    },
    "compliance_engine": {
      "overall_status": ["COMPLIANT", "PARTIALLY_COMPLIANT", "NON_COMPLIANT", "UNDER_REVIEW"],
      "legal_compliance": {
        "ownership_verified": true,
        "identity_verified": true,
        "certificate_valid": true,
        "not_stolen": true,
        "not_under_dispute": true,
        "court_restrictions": false
      },
      "regulatory_compliance": {
        "export_requirements_met": true,
        "insurance_requirements_met": true,
        "museum_requirements_met": true,
        "customs_requirements_met": true,
        "cultural_heritage_requirements_met": true
      },
      "international_standards": [
        "ISO 9001", "ISO 27001", "ISO 8601", "ISO 3166-1",
        "W3C Verifiable Credentials", "C2PA", "CIDOC CRM", "Dublin Core"
      ]
    },
    "verification_services": {
      "public_verification": {
        "enabled": true,
        "verification_url": "",
        "verification_qr": "",
        "verification_methods": ["QR Code", "Certificate Number", "Passport Number", "UUID", "NFC", "Barcode"]
      },
      "verification_response": {
        "passport_status": "",
        "certificate_status": "",
        "trust_grade": "",
        "overall_trust_score": 0,
        "verification_timestamp": "",
        "verification_reference": "",
        "last_updated": ""
      }
    },
    "api_services": {
      "version": "v1",
      "authentication": { "method": ["OAuth2", "API Key", "JWT", "mTLS"] },
      "base_endpoint": "/api/v1",
      "resources": [
        { "resource": "/passports", "methods": ["GET", "POST", "PUT", "PATCH"] },
        { "resource": "/verification", "methods": ["GET"] },
        { "resource": "/certificates", "methods": ["GET", "POST"] },
        { "resource": "/ownership", "methods": ["GET", "POST"] },
        { "resource": "/provenance", "methods": ["GET", "POST"] },
        { "resource": "/valuations", "methods": ["GET", "POST"] },
        { "resource": "/restorations", "methods": ["GET", "POST"] },
        { "resource": "/exports", "methods": ["GET", "POST"] }
      ],
      "response_format": "JSON",
      "time_format": "ISO 8601",
      "uuid_standard": "RFC 4122"
    },
    "timeline_engine": {
      "enabled": true,
      "chronological": true,
      "immutable": true,
      "timeline_events": [
        "Created", "Registered", "Verified", "Certified", "Transferred", "Valuated",
        "Insured", "Exhibited", "Restored", "Conserved", "Exported", "Imported", "Archived"
      ],
      "event_schema": {
        "event_uuid": "",
        "event_type": "",
        "timestamp": "",
        "performed_by": "",
        "location": "",
        "reference": "",
        "digital_signature": ""
      }
    },
    "lifecycle_management": {
      "states": [
        "Draft", "Registered", "Verified", "Certified", "Active", "Transferred",
        "Restored", "Exhibited", "Exported", "Archived", "Retired"
      ],
      "allowed_transitions": [
        { "from": "Draft", "to": "Registered" },
        { "from": "Registered", "to": "Verified" },
        { "from": "Verified", "to": "Certified" },
        { "from": "Certified", "to": "Active" },
        { "from": "Active", "to": "Transferred" },
        { "from": "Active", "to": "Restored" },
        { "from": "Active", "to": "Exhibited" },
        { "from": "Active", "to": "Exported" },
        { "from": "Active", "to": "Archived" },
        { "from": "Archived", "to": "Retired" }
      ]
    },
    "digital_twin": {
      "enabled": true,
      "twin_uuid": "",
      "twin_version": "1.0",
      "synchronization": { "mode": ["Real-Time", "Scheduled", "Manual"], "current_mode": "Real-Time" },
      "mirror_components": [
        "Identity", "Ownership", "Certificates", "Trust Scores", "Timeline", "Condition",
        "Conservation", "Valuations", "Insurance", "Compliance", "Export", "Risk"
      ],
      "consistency_validation": { "enabled": true, "continuous": true }
    },
    "events": {
      "supported": [
        "Passport Created", "Passport Updated", "Ownership Changed", "Certificate Issued",
        "Certificate Revoked", "Trust Score Updated", "Export Approved", "Insurance Updated",
        "Restoration Completed", "Exhibition Added", "Timeline Event Added"
      ]
    },
    "notifications": {
      "channels": ["Email", "SMS", "Push", "Webhook", "In-App"],
      "automatic_notifications": [
        "Certificate Expiring", "Insurance Expiring", "Export Approved", "Export Rejected",
        "Ownership Transfer", "Trust Score Changed", "Risk Level Increased", "Passport Updated"
      ]
    },
    "analytics": {
      "passport_age_days": 0,
      "timeline_events": 0,
      "ownership_changes": 0,
      "verification_requests": 0,
      "api_requests": 0,
      "exports_completed": 0,
      "active_certificates": 0,
      "trust_score_history": []
    },
    "interoperability": {
      "supported_formats": ["JSON", "JSON-LD", "XML", "CSV", "PDF/A"],
      "external_integrations": [
        "Museum Collection Systems", "Gallery Management Systems", "Insurance Platforms",
        "Customs Platforms", "Government Registries", "National Heritage Databases",
        "Auction Platforms", "Logistics Platforms"
      ]
    },
    "future_reserved": {
      "digital_product_passport_eu": false,
      "decentralized_identifiers": false,
      "verifiable_credentials": true,
      "blockchain_interoperability": false,
      "smart_contract_support": false,
      "digital_asset_tokenization": false,
      "metaverse_representation": false,
      "ai_semantic_search": false,
      "global_trust_network": false
    }
  }
}
