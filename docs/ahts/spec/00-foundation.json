  "guiding_principles": [
    { "id": "GP001", "name": "Authenticity", "description": "Every claim must be independently verifiable." },
    { "id": "GP002", "name": "Integrity", "description": "Records must not be altered without traceability." },
    { "id": "GP003", "name": "Transparency", "description": "Authorized users can verify provenance and certificate status." },
    { "id": "GP004", "name": "Security", "description": "Physical and digital protections work together." },
    { "id": "GP005", "name": "Privacy", "description": "Personal information is protected according to applicable laws." },
    { "id": "GP006", "name": "Interoperability", "description": "Use open standards where practical for integration." },
    { "id": "GP007", "name": "Scalability", "description": "The architecture supports expansion across countries and institutions." },
    { "id": "GP008", "name": "Accessibility", "description": "Verification services should be accessible across devices." },
    { "id": "GP009", "name": "Preservation", "description": "Maintain long-term records of cultural heritage." },
    { "id": "GP010", "name": "Governance", "description": "Every certificate follows documented approval workflows." }
  ],
