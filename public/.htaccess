# Directory listings off even where mod_negotiation is absent.
Options -Indexes
<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Never serve a dot-file out of the web root.
    #
    # There should not be one here — .env lives a level above, outside the
    # document root. This is the second lock: a stray copy of .env pasted in
    # while debugging, an editor's .env.swp, a .git left behind by a future
    # deploy, would otherwise be downloadable as plain text by anyone who
    # guesses the name.
    #
    # /.well-known/ is exempt and must stay exempt: it carries
    # /.well-known/jwks.json — the published signing key that lets a third party
    # verify a certificate without asking this site anything — and the
    # acme-challenge files your host writes when it renews the TLS certificate.
    # Blocking it breaks certificate verification and, eventually, HTTPS itself.
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteRule (^|/)\. - [F]

    # Force HTTPS.
    #
    # SESSION_SECURE_COOKIE=true in .env, so over plain http the browser is
    # never given a session cookie: the login form posts, the CSRF token cannot
    # be matched, and the visitor gets "page expired" with nothing to explain
    # it. Anyone who types the bare domain arrives on http. Both scheme tests
    # are needed — %{HTTPS} is off when TLS is terminated by a proxy in front of
    # Apache, and X-Forwarded-Proto is what that proxy sets instead; requiring
    # both to be absent keeps this from looping.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
    RewriteCond %{HTTP_HOST} !\.test$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# ---------------------------------------------------------------------------
# Compression.
#
# Nothing here compressed anything before this block existed, which meant the
# stylesheet went over the wire at its full 160 KB when it deflates to about
# 24 KB. On a phone on Cameroonian mobile data that difference is most of the
# wait before the page looks like anything.
#
# mod_deflate is the one that is actually present on this host; mod_brotli is
# listed first because it compresses better and Apache will use it when the
# host eventually has it. Both blocks are guarded, so a server missing either
# module ignores the block instead of returning 500 — an unguarded directive
# for an absent module is a fatal config error, not a no-op.
#
# Images, woff2 and .gz files are deliberately absent: they are already
# compressed, and running deflate over them costs CPU to make them very
# slightly larger.
# ---------------------------------------------------------------------------
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json application/xml
    AddOutputFilterByType BROTLI_COMPRESS image/svg+xml application/manifest+json
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml application/manifest+json
</IfModule>

# ---------------------------------------------------------------------------
# Caching.
#
# The rule that makes this safe: everything cached for a year is requested
# through asset_v(), which stamps the URL with the file's mtime. Change the
# file, the URL changes, the browser fetches it. Without that stamp a one-year
# cache would mean an update never reaching anyone who had already visited.
#
# HTML is explicitly never cached. It carries the CSRF token and the logged-in
# session's markup; a cached page would hand a stale token to the next visitor
# and produce "page expired" on the first form they submit.
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                      "access plus 1 year"
    ExpiresByType application/javascript        "access plus 1 year"
    ExpiresByType text/javascript               "access plus 1 year"
    ExpiresByType font/woff2                    "access plus 1 year"
    ExpiresByType image/png                     "access plus 30 days"
    ExpiresByType image/jpeg                    "access plus 30 days"
    ExpiresByType image/webp                    "access plus 30 days"
    ExpiresByType image/svg+xml                 "access plus 30 days"
    ExpiresByType image/x-icon                  "access plus 30 days"
    ExpiresByType text/html                     "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    # "immutable" tells the browser not even to send a revalidation request.
    # Correct only because the filename or its ?v= stamp changes on every edit.
    <FilesMatch "\.(css|js|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # The service worker must never be cached, or a phone can be pinned to an
    # old worker that keeps serving an old shell after the site has moved on.
    <FilesMatch "^sw\.js$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>
