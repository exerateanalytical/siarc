{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "build:css": "tailwindcss -c tailwind.config.cjs -i resources/css/tailwind-static.css -o public/vendor/app.css --minify",
