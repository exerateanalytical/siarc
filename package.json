        "build:assets": "npm run build:css && npm run build:icons"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^3.1",
        "lucide": "^1.23.0",
        "tailwindcss": "^3.4.17",
        "vite": "^8.0.0"
    }
}
